# ===== KaoyanVocab 配置模板 =====
# 使用方法：复制本文件为 .env，填入你的密钥（.env 不会被提交到 Git）

# DeepSeek（主翻译来源，必填）
DEEPSEEK_API_KEY=sk-在这里填入你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 小米 MiMo（可选，OpenAI 兼容接口，网页右上角可切换）
MIMO_API_KEY=sk-在这里填入你的MiMo密钥
MIMO_BASE_URL=https://api.xiaomimimo.com
MIMO_MODEL=mimo-v2.5
